# Copy this file to .env and edit only what you need:
# cp .env.example .env

# Host identity
TZ=Asia/Kolkata
PUID=1000
PGID=1000
HOSTNAME=homelab

# Base directories on the host.
# Keep these relative for the easiest setup, or replace with absolute paths.
CONFIG_DIR=./config
DATA_DIR=./data
DOWNLOADS_DIR=./downloads
FILES_DIR=./files
MEDIA_DIR=./media-samples
NOTES_DIR=./notes

# Dashboard and service binding.
# 0.0.0.0 makes services reachable on your LAN/Tailscale.
# 127.0.0.1 keeps them local-only, useful if exposing only via Cloudflare Tunnel.
BIND_IP=0.0.0.0

# FileBrowser first login is admin / admin unless you change it in the UI.
# WebDAV credentials are used by rclone's WebDAV server.
WEBDAV_USER=homelab
WEBDAV_PASS=change-this-webdav-password

# Homepage allowed hosts. Use "*" for first boot, then restrict later.
HOMEPAGE_ALLOWED_HOSTS=*

# Optional Cloudflare Tunnel token.
# Create a tunnel in Cloudflare Zero Trust and paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=
